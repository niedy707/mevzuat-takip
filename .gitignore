kayit/rapor-durum.json
kayit/rg-belge/
# yayin.py / acil_is.py: yayın durumu, acil nabzı, iş kilidi
kayit/yayin-durum.json
kayit/acil-nabiz.json
kayit/.is-kilidi
# Üretilen public site (Vercel'e CLI ile yüklenir; .vercel bağlantısı burada)
yayin/

# Python
__pycache__/
*.pyc
.venv/

# macOS
.DS_Store


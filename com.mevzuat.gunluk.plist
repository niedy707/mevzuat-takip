<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.mevzuat.gunluk</string>

  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/python3</string>
    <string>__PROJE_YOLU__/gunluk_is.py</string>
  </array>

  <key>WorkingDirectory</key>
  <string>__PROJE_YOLU__</string>

  <!-- Her gun 09:00. Resmi Gazete sabah yayimlanir; konsolidasyon
       gun icinde islenir, bu yuzden sabah kosusu gunun haberini yakalar. -->
  <key>StartCalendarInterval</key>
  <dict><key>Hour</key><integer>9</integer><key>Minute</key><integer>0</integer></dict>

  <!-- Mac o saatte uykudaysa uyaninca bir kez kosar. -->
  <key>RunAtLoad</key><false/>

  <key>StandardOutPath</key>
  <string>__PROJE_YOLU__/kayit/gunluk.log</string>
  <key>StandardErrorPath</key>
  <string>__PROJE_YOLU__/kayit/gunluk-hata.log</string>

  <key>EnvironmentVariables</key>
  <dict>
    <!-- pdftotext /opt/homebrew/bin'de; launchd varsayilan PATH'i onu gormez. -->
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>LANG</key><string>tr_TR.UTF-8</string>
  </dict>

  <key>ProcessType</key><string>Background</string>
  <key>LowPriorityIO</key><true/>
</dict>
</plist>
